# Configurações do Servidor
PORT=3000

# Conexão com o Supabase (Obrigatório)
SUPABASE_URL=https://sua-url-do-supabase.supabase.co
SUPABASE_KEY=seu-token-anon-ou-service-role-key

# Configurações do Crawler (Intervalo em milissegundos. Padrão: 5 minutos = 300000)
CRAWLER_INTERVAL=300000

# Auto Ping (Opcional - Usado para evitar que o servidor entre em modo de suspensão em plataformas como Render/Render-like)
# Suporta múltiplas URLs separadas por vírgula
AUTO_PING_URL=http://localhost:3000/api/health
AUTO_PING_INTERVAL=300000

# Integração com Discord (Opcional - defina ENABLE_DISCORD=false para desativar)
ENABLE_DISCORD=true
DISCORD_BOT_TOKEN=seu-token-do-bot-do-discord
DISCORD_CHANNEL_ID=seu-id-do-canal-do-discord

